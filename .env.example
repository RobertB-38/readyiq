# Copy to .env and fill in. NEVER commit .env.

# --- Azure AI Foundry / Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Deployment names you create in Foundry (not model names)
AZURE_OPENAI_DEPLOYMENT_PROD=gpt-4o
AZURE_OPENAI_DEPLOYMENT_DEV=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# --- Foundry IQ (knowledge base on Azure AI Search) ---
AZURE_SEARCH_ENDPOINT=https://tribunal-search.search.windows.net
AZURE_SEARCH_KEY=<your-search-admin-key>
FOUNDRY_KB_NAME=sec-filings-kb
AZURE_SEARCH_API_VERSION=2025-11-01-preview

# --- App config ---
# dev -> uses gpt-4o-mini (cheap). demo -> uses gpt-4o.
APP_MODE=dev
